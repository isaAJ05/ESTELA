#!/bin/sh

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# ClickUp Task ID obligatorio.
#
# Formatos aceptados:
#   CU-abc123
#   #abc123
#   EST-123
#
# El ID debe aparecer como una palabra independiente.

if ! printf '%s\n' "$COMMIT_MSG" | grep -Eq '(^|[[:space:]])(CU-[A-Za-z0-9][A-Za-z0-9-]*|#[A-Za-z0-9][A-Za-z0-9-]*|[A-Za-z]+-[0-9]+)([[:space:]]|$)'; then

    echo ""
    echo "ERROR: Commit rechazado."
    echo ""
    echo "El commit debe incluir un ClickUp Task ID."
    echo ""
    echo "Ejemplos validos:"
    echo "  CU-abc123"
    echo "  #abc123"
    echo "  EST-123"
    echo ""
    echo "Ejemplo correcto:"
    echo ""
    echo "  feat(pose): mejorar deteccion de postura"
    echo ""
    echo "  CU-abc123"
    echo ""

    exit 1
fi

exit 0
