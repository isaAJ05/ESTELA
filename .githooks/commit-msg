#!/bin/sh

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# ClickUp acepta:
# #task_id
# CU-task_id
# custom_task_id
# #custom_task_id
#
# Ejemplos:
# #1abc2de
# CU-1abc2de
# eng-123
# #eng-123

if ! printf '%s\n' "$COMMIT_MSG" | grep -Eq '(^|[[:space:]])(#[A-Za-z0-9][A-Za-z0-9-]*|CU-[A-Za-z0-9][A-Za-z0-9-]*)([[:space:]]|$)'; then
    echo ""
    echo "ERROR: El commit debe incluir un ClickUp Task ID."
    echo ""
    echo "Ejemplos validos:"
    echo "  #1abc2de"
    echo "  CU-1abc2de"
    echo "  #eng-123"
    echo ""
    echo "Ejemplo:"
    echo "  feat(pose): mejorar deteccion de postura"
    echo ""
    echo "  #eng-123"
    echo ""
    exit 1
fi

exit 0
