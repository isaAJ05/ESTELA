@startuml INTERACCION_modulos
' Diagrama de interacción entre módulos de ESTELA (SegundoInforme §10.3).
' Formato del diagrama de componentes original (diagramas/componentes.wsd),
' completado con el código de test y de feature/reconocimiento-ejercicio.
' Notación UML: componente, interfaz ofrecida (-() ), interfaz requerida
' (--( ), dependencia (flecha punteada) y artefacto (archivo).
' Las capas van de izquierda a derecha: tecnologías externas, adaptadores,
' puertos, aplicación y dominio.
' Se omite Orquestador --( Estimador: el orquestador solo recibe la función que
' crea el estimador y se la pasa a la sesión, que es quien lo usa.
' Render: PlantUML con Graphviz. Sin Graphviz, descomentar la línea siguiente.
' !pragma layout smetana

title ESTELA — Diagrama de interacción entre módulos\n(un solo proceso de Python; llama-server es un proceso aparte)

left to right direction
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontSize 12
skinparam ArrowFontSize 10
skinparam nodesep 35
skinparam ranksep 55

package "Tecnologías externas" as EXT {
  component "Interfaz React\n«en la ventana pywebview»" as REACT
  component "OpenCV\n«biblioteca»" as OCVLIB
  component "Piper\n«biblioteca»" as PIPER
  component "MediaPipe\n«biblioteca»" as MPLIB
  component "llama-server\n«proceso externo, opcional»" as LLAMA
}
node "Cámara física" as HWCAM

component "Arranque\n(<U+005F><U+005F>main<U+005F><U+005F>.py)" as MAIN

package "Adaptadores" as AD {
  component "Orquestador y ventana\n(interfaz/)" as ORQ
  component "Fuente de cámara y video\n(captura/)" as CAM
  component "Cola de voz y motores\n(voz/)" as VOZ
  component "Estimador de pose\n(pose/)" as EP
  component "Verbalizador con LLM\n(llm/; implementado,\nhoy solo lo usa EXP-001)" as LLM
}

package "Aplicación" as AP {
  interface "Fuente" as IFUENTE
  interface "Voz" as IVOZ
  interface "Estimador" as IEST
  component "Sesión y pausas" as SES
  component "Reconocedor de ejercicio" as REC
  component "Rutina y catálogo" as RUT
  component "Umbrales relativos" as UMB
  component "Alineador DTW" as DTW
  component "Registro por repetición" as REG
  component "Latencias y métricas" as MET
}

package "Dominio" as DO {
  artifact "referencias/*.json\n(por ejercicio y\nde reconocimiento)" as REFS
  artifact "skills/*.json" as SKILL
  component "Motor de feedback\n(MotorFeedback)" as MF
  component "Geometría" as GEO
  component "Segmentador" as SEG
  component "Motor de decisión" as MOT
  interface " " as IVERB
  component "Verbalizador por plantillas\ny validador" as VER
}

component "Creadores de referencias\n(scripts/crear_referencia*.py)\n«offline»; reutilizan el estimador,\nla geometría, el segmentador y el catálogo" as CR
artifact "Video de referencia\n(fuera del repositorio)" as VIDEO

' Aristas en orden de izquierda a derecha, fila por fila.
' -------------------------------------------------------------- arranque
MAIN ..> AD : «crea e inyecta»
MAIN ..> SES : «usa sin ventana\n(--interfaz opencv)»

' --------------------------------------------------------------- externos
REACT <.. ORQ : «JSON»
HWCAM <.. OCVLIB
OCVLIB <.. CAM
MPLIB <.. EP
PIPER <.. VOZ
LLAMA <.. LLM : «HTTP local»

' --------------------------------------------------------------- puertos
ORQ ..> SES
ORQ -down-( IFUENTE
CAM -down-() IFUENTE
EP -down-() IEST
VOZ -down-() IVOZ
SES -up-( IEST
SES -up-( IVOZ

' ------------------------------------------------- dependencias entre capas
SES ..> REC
SES ..> RUT
SES ..> MF
SES ..> GEO
SES ..> SEG
SES ..> DTW
SES ..> REG
SES ..> MET
REC ..> REFS : «lee»
RUT ..> REFS : «lee»
RUT ..> SKILL : «lee»
RUT .right.> UMB
MF ..> MOT
MF --( IVERB : Verbalizador
' (el nombre de la interfaz va en esta línea y no bajo el círculo, donde lo
' cruzaría la línea del verbalizador con LLM)
VER -left-() IVERB
LLM -() IVERB

' Acerca el orquestador al arranque, arriba de su columna (sin dibujar)
MAIN -[hidden]-> ORQ

' --------------------------------------------------------------- offline
REFS <.. CR : «genera»
CR .right.> VIDEO : «lee»

legend bottom left
  Aplicación: biblioteca estándar y NumPy. Dominio: solo biblioteca estándar.
  Flecha punteada: dependencia (el origen usa al destino). Círculo: interfaz que el componente ofrece;
  semicírculo: interfaz que requiere. Se omite Orquestador --( Estimador (solo pasa la función que lo crea).
endlegend
@enduml
