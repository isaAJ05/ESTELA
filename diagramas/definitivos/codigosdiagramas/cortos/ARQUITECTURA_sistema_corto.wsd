@startuml ARQUITECTURA_sistema_corto
' Versión corta de ARQUITECTURA_sistema.wsd para diapositivas.

title ESTELA — Arquitectura

left to right direction
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontSize 16
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam nodesep 40
skinparam ranksep 120
skinparam rectangle {
  BorderStyle dashed
}

actor "Usuaria" as USU

rectangle "Equipo de la usuaria — todo se ejecuta en local" as EQ {
  node "Altavoces" as ALT
  node "Cámara web" as CAM
  component "Interfaz de escritorio" as UI
  component "Núcleo de análisis\n(Python)" as NUC
  component "Piper\n(voz)" as PIP
  component "MediaPipe\n(pose)" as MP
  folder "Ejercicios\n(skills y referencias)" as CONF
}

component "Preparación offline\nde referencias" as OFF

USU <-- ALT : correcciones\nen español
USU --> CAM : hace el\nejercicio
USU --> UI : elige la rutina

ALT <-- NUC : voz
CAM --> NUC : fotogramas
UI <--> NUC : comandos /\nestado
NUC --> PIP
NUC --> MP
NUC --> CONF : lee

OFF --> CONF : genera
@enduml
