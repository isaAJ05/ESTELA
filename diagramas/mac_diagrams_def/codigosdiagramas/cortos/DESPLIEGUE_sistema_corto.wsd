@startuml DESPLIEGUE_sistema_corto
' Versión corta de DESPLIEGUE_sistema.wsd para diapositivas — rama
' feature/mac-flujo (commit 8248abb). Frente a la de test añade el micrófono,
' Whisper, Ollama con sus dos modelos y la GPU del Mac.

title ESTELA — Despliegue

left to right direction
skinparam shadowing false
skinparam defaultFontSize 16
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam nodesep 40
skinparam ranksep 100

node "Cámara web" as CAMD
node "Micrófono" as MICD
node "Altavoces" as AUD

node "Mac con Apple Silicon" as MAC {
  node "Python\n(estela, MediaPipe,\nPiper, Whisper)" as PY
  node "Ventana pywebview\n(interfaz React)" as WEB
  node "Ollama\n(qwen3 4B y 14B)" as OLL
  node "GPU\n(Metal)" as GPU
  folder "Modelos, skills\ny referencias" as FS
  folder "Historial\n(perfiles y progreso)" as HIS
}

CAMD --> PY : fotogramas
MICD --> PY : órdenes
AUD <-- PY : voz
PY <--> WEB : HTTP local
PY --> OLL : HTTP local
PY --> GPU
OLL --> GPU
PY --> FS : lee
PY --> HIS : guarda

legend bottom left
  Todo se ejecuta en el equipo: ningún dato sale durante la sesión.
  Memoria en uso ≈14,4 GB; mínimo estimado 24 GB (no medido).
endlegend
@enduml
