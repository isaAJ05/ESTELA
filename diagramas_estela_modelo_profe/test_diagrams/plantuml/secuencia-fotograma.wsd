@startuml
title Secuencia - Corrección de un fotograma en la sesión en vivo

actor Usuario
participant "Interfaz" as UI
participant "Orquestador" as ORQ
participant "Cámara" as CAM
participant "Sesión" as SES
participant "Estimador de Pose" as EP
participant "Motor de Feedback" as MF
participant "Cola de Voz" as VOZ

loop mientras la sesión esté activa
  ORQ -> CAM : leer()
  CAM --> ORQ : último fotograma
  ORQ -> SES : procesar(fotograma)
  SES -> EP : estimar(fotograma)
  EP --> SES : puntos articulares
  SES -> SES : revisar el gesto de pausa\n(brazo derecho arriba 3 s)

  alt pausa pedida por el usuario (botón o gesto)
    SES --> ORQ : estado en pausa
  else no se detecta a la persona
    SES --> ORQ : estado con aviso (sin persona)
  else colocándose al empezar el ejercicio
    SES -> SES : revisar orientación y cuerpo entero
    opt bien colocado durante 1,5 s seguidos
      SES -> VOZ : decir(«Ya te veo bien»)
    end
    SES --> ORQ : estado de colocación
  else hay persona y el ejercicio está en curso
    SES -> SES : calcular ángulos, fase y repetición\n(Geometría, Segmentador, DTW, Reconocedor)
    alt sesión en pausa
      SES -> VOZ : decir(aviso de pausa)
    else sesión activa
      SES -> MF : procesar(observación)
      alt hay error o refuerzo
        MF --> SES : mensaje de feedback
        SES -> VOZ : decir(mensaje)
        VOZ --> Usuario : frase hablada
      else se calla
        MF --> SES : silencio (motivo)
      end
      opt hace otro ejercicio
        SES -> VOZ : decir(«Ese movimiento no es el de ahora»)
      end
    end
    SES --> ORQ : estado del fotograma
  end
end

group En paralelo, en el hilo de la interfaz
  UI -> ORQ : consultar estado
  ORQ --> UI : estado más reciente (JSON)
  UI --> Usuario : mostrar sesión
end
@enduml
