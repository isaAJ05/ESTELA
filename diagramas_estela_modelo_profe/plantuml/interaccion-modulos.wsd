@startuml
title Interacción entre Módulos de ESTELA

actor Usuario
[Interfaz React] as React

package "Adaptadores de entrada" {
  [Orquestador e Interfaz] as ORQ
  [Captura] as CAP
}

package "Aplicación" {
  [Sesión] as SES
  [Rutina] as RUT
  [Alineador DTW] as DTW
  [Registro por repetición] as REG
  [Pausa y Métricas] as PAU
}

package "Dominio" {
  [Geometría] as GEO
  [Segmentador] as SEG
  [Motor de Feedback] as MF
  [Motor de Decisión] as DEC
  [Verbalizador y Validador] as VER
  [Skills] as SKI
}

package "Adaptadores de salida" {
  [Pose] as POSE
  [Voz] as VOZ
  [Verbalizador LLM] as VLLM
}

[Cámara web] as Cam
[MediaPipe] as MP
[Piper] as Piper
[llama-server] as LLM

Usuario --> React
React --> ORQ
ORQ --> CAP
ORQ --> SES
CAP --> Cam

SES --> RUT
SES --> DTW
SES --> REG
SES --> PAU
SES --> GEO
SES --> SEG
SES --> MF
SES --> POSE
SES --> VOZ

MF --> DEC
MF --> VER
DEC --> SKI
RUT --> SKI

VLLM --> VER
POSE --> MP
VOZ --> Piper
VLLM --> LLM
@enduml
